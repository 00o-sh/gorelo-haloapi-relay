{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":pinAllExceptPeerDependencies"
  ],
  "rangeStrategy": "pin",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-5 * * *"],
    "automerge": true,
    "commitMessageAction": "Refresh lock file"
  },
  "postUpgradeTasks": {
    "commands": ["npm approve-scripts workerd esbuild"],
    "fileFilters": ["package.json"],
    "executionMode": "branch"
  }
}
